{
  "manifest_version": 3,
  "name": "Dotted Line by Deal Dates",
  "short_name": "Dotted Line",
  "version": "0.1.2",
  "description": "Turn your WEBForms forms into a Real Signature draft on your reZEN deal, signature blocks placed. You review it and send it. Free.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "scripting"],
  "host_permissions": [
    "https://pr.transactiondesk.com/*",
    "https://signature.therealbrokerage.com/*"
  ],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "side_panel": { "default_path": "src/panel/panel.html" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Dotted Line",
    "default_icon": { "16": "icons/toolbar-16.png", "32": "icons/toolbar-32.png" }
  },
  "options_ui": { "page": "src/options/options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["https://pr.transactiondesk.com/*"],
      "js": ["src/webforms/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://signature.therealbrokerage.com/*"],
      "js": ["src/realsig/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/lib/*.js"],
      "matches": ["https://pr.transactiondesk.com/*", "https://signature.therealbrokerage.com/*"]
    }
  ]
}
