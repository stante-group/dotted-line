{
  "manifest_version": 3,
  "name": "Dotted Line by Deal Dates",
  "short_name": "Dotted Line",
  "version": "0.1.0",
  "description": "Turn the forms you filled in WEBForms into a Real Signature draft on your reZEN deal, with signature blocks placed. You review it and press Send yourself. Free.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "tabs", "scripting"],
  "host_permissions": [
    "https://pr.transactiondesk.com/*",
    "https://signature.therealbrokerage.com/*"
  ],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "side_panel": { "default_path": "src/panel/panel.html" },
  "action": { "default_title": "Dotted Line" },
  "content_scripts": [
    {
      "matches": ["https://pr.transactiondesk.com/*"],
      "js": ["src/webforms/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://signature.therealbrokerage.com/*"],
      "js": ["src/realsig/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/lib/*.js"],
      "matches": ["https://pr.transactiondesk.com/*", "https://signature.therealbrokerage.com/*"]
    }
  ]
}
